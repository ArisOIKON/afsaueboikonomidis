							"text": "DELETE FROM dw.FactSales;\nDELETE FROM dw.DimTerritory;\nINSERT INTO dw.DimTerritory (\nTerritoryID,\nTerritoryName,\nCountryRegionCode,\nTerritoryGroup\n)\nSELECT\nTerritoryID,\nName AS TerritoryName,\nCountryRegionCode,\n[Group] AS TerritoryGroup\nFROM stg.SalesTerritory;"
						}
					],
