				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "etl_dw_1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "DELETE FROM dw.DimCustomer;\nINSERT INTO dw.DimCustomer (\nCustomerID,\nCustomerType,\nFirstName,\nLastName,\nMiddleName,\nAge\n)\nSELECT\nc.CustomerID,\nCASE\nWHEN c.PersonID IS NOT NULL THEN 'Person'\nWHEN c.StoreID IS NOT NULL THEN 'Store'\nELSE 'Unknown'\nEND AS CustomerType,\np.First_Name,\np.Last_Name,\np.Middle_Name,\np.Age\nFROM wrk.Customer c\nLEFT JOIN wrk.Person p\nON c.PersonID = p.BusinessEntityID;"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "DimDate",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Data flow3",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
